{
  "name": "hanami",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5191 --strictPort",
    "build": "vite build && node scripts/finish-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4191 --strictPort",
    "check": "node --check src/game/app.js && node --check src/game/engine.js && node --check src/game/repository.js && node --check src/gallery.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "firebase emulators:exec --project demo-hanami --only auth,firestore \"playwright test\"",
    "test:e2e:update": "firebase emulators:exec --project demo-hanami --only auth,firestore \"playwright test --update-snapshots=all\"",
    "test:rules": "firebase emulators:exec --project demo-hanami --only auth,firestore \"node --test tests/rules/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "firebase-tools": "^15.35.0",
    "pngjs": "^7.0.0",
    "vite": "^8.1.4"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "firebase": "^13.2.0"
  }
}
